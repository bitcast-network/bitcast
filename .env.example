# --- Validator ---------------------------------------------------------------

# LLM provider for brief matching: "chutes" (default) or "openrouter"
LLM_PROVIDER=chutes
CHUTES_API_KEY=
OPENROUTER_API_KEY=

# RapidAPI key for the YouTube transcript service
RAPID_API_KEY=

# Bitcast services (defaults shown)
#BITCAST_API_URL=https://bitcast-api.bitcast.network
#DATA_CLIENT_URL=http://44.254.20.95

# Briefs endpoint. Defaults to "$BITCAST_API_URL/api/v2/validator/briefs";
# set this to override the full URL independently of BITCAST_API_URL (e.g. to
# point a canary at a staging briefs server). A successful fetch is mirrored to
# the validator's on-disk cache, which is used if the server is unreachable.
#BITCAST_BRIEFS_ENDPOINT=https://bitcast-api.bitcast.network/api/v2/validator/briefs

# Publish evaluation results to the dashboard (default false)
#ENABLE_DATA_PUBLISH=false

# Eco mode: only LLM-check videos that pass every other gate (default true)
#ECO_MODE=true

# Prompt-injection screening (disabled by default; costs 15-30s per request)
#DISABLE_PROMPT_INJECTION=true
#DISABLE_LLM_CACHING=false

# Subnet mechanism id (default 0)
#MECHID=0

# --- Monitoring ---------------------------------------------------------------

# Sentry DSN. Leave unset to disable Sentry (capture_exception falls back to bt.logging).
#SENTRY_DSN=https://<key>@o4511411576832000.ingest.us.sentry.io/<project_id>
#SENTRY_ENVIRONMENT=production

# Grafana Loki — enabled by default for the shared Bitcast dataset.
# Override all three only to use a different Grafana Cloud stack.
#LOKI_URL=https://logs-prod-<stack>.grafana.net
#LOKI_USERNAME=<stack-id>
#LOKI_TOKEN=<access-policy-token>

# --- Miner ---------------------------------------------------------------------

# Token source: "local" (JSON credential files) or "api" (Bitcast credentials API)
#TOKEN_SOURCE=local

# local: directory of JSON files with client_id/client_secret/refresh_token
#BITCAST_SECRETS_DIR=~/.bitcast/secrets

# api: served access tokens
#BITCAST_API_KEY=
